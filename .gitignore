# =============================================================================
# LLM Eval Suite — .gitignore
# =============================================================================
#
# Philosophy:
#   IGNORE  → generated, reproducible, or sensitive (credentials, build artefacts,
#             caches, large binary data).
#   COMMIT  → curated, irreproducible, or shared config (source code, manually
#             curated datasets, selected final results, shared IDE settings).
#
# Reproducing ignored artefacts:
#   chroma_db/   → python scripts/ingest.py
#   datasets/    → python scripts/build_datasets.py
#   .venv/       → uv sync
#   results/     → python scripts/run_benchmark.py  (or evaluate_rag.py)


# ── Credentials and environment variables ────────────────────────────────────
# NEVER commit API keys (OLLAMA_API_KEY, GEMINI_API_KEY, LANGSMITH_API_KEY).
# Use .env.example as a committed template with placeholder values.
.env
.env.local
.env.*.local
*.pem
*.key


# ── Python bytecode and build artefacts ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
eggs/
*.egg-info/
*.egg
.eggs/


# ── Virtual environments ──────────────────────────────────────────────────────
# Project uses uv — .venv is the standard venv location.
# Restore with: uv sync
.venv/
venv/
env/
ENV/
.virtualenv/


# ── Pytest / Coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.coveragerc


# ── Type checkers and linters ─────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json


# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
# Checkpoint directories are always regenerated on notebook open.
.ipynb_checkpoints/
*/.ipynb_checkpoints/
# Exported notebook renders are regenerable — commit the .ipynb source instead.
notebooks/*.html
notebooks/*.pdf


# ── ChromaDB (local vector store) ─────────────────────────────────────────────
# Generated by scripts/ingest.py. Can grow to several GB for large corpora.
# Reproduce with: python scripts/ingest.py
# Keeping this out of git also prevents stale embeddings from silently
# poisoning retrieval results when the embedding model changes.
chroma_db/
*.chroma/
02_rag_eval/chroma_db/


# ── Downloaded datasets ───────────────────────────────────────────────────────
# Reproducible via scripts/build_datasets.py — no need to version large JSONL files.
01_benchmark/datasets/mmlu_sample.jsonl
01_benchmark/datasets/humaneval_sample.jsonl

# EXCEPTION: curated_qa.jsonl and raw/ are hand-curated and cannot be
# regenerated automatically — always commit them.
!03_dataset/curated_qa.jsonl
!03_dataset/raw/


# ── Benchmark and RAG evaluation results ──────────────────────────────────────
# Intermediate and exploratory run results are ignored to keep history clean.
# To preserve a result permanently, copy it to docs/results/ and commit there.
01_benchmark/results/
02_rag_eval/results/


# ── Logs and traces ───────────────────────────────────────────────────────────
*.log
logs/
# LangSmith local trace exports — remote traces are preserved in the LangSmith UI.
langsmith_traces/


# ── Operating system artefacts ────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.nfs*


# ── IDE configuration ─────────────────────────────────────────────────────────

# VS Code — commit .vscode/settings.json and .vscode/extensions.json
# (shared formatter and linter config), but ignore personal launch configs
# and workspace files that contain absolute paths.
.vscode/launch.json
.vscode/*.code-workspace

# PyCharm — entire .idea/ directory contains local absolute paths and
# per-developer run configurations.
.idea/
*.iml
*.iws


# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.swp
*.swo
tmp/
temp/


# ── Distribution and packaging ────────────────────────────────────────────────
*.whl
*.tar.gz
*.zip
MANIFEST