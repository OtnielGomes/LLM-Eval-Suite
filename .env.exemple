# =============================================================================
# LLM Eval Suite — .env.example
# =============================================================================
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# .env is listed in .gitignore and will NEVER be committed.
# This file (.env.example) IS committed — it documents required variables
# with placeholder values safe to share publicly.
#
# All variables are read lazily (os.getenv() at call time, not at import),
# so changes to .env take effect on the next process start without needing
# a Python reload.
# =============================================================================


# ── Ollama Cloud — generation, RAG, and LLM-as-judge ─────────────────────────
# Required. Used by OllamaCloudClient, RAGPipeline, and _build_langchain_llm.
# Generate a key at: https://ollama.com/settings/keys
OLLAMA_API_KEY=ollama_sk_...

# Model used for generation and judge calls via Ollama Cloud.
# Default (if unset): llama3.3:70b  (set in shared/config.py)
# Other options: llama3.1:8b (faster, lower quality), qwen3:32b
OLLAMA_CLOUD_MODEL=llama3.3:70b


# ── Ollama Local — embeddings (optional overrides) ───────────────────────────
# Only required if you need to override the defaults in shared/config.py.
# The local Ollama daemon must be running: https://ollama.com/download
# Pull the embedding model once with: ollama pull nomic-embed-text
#
# WARNING: OLLAMA_EMBED_MODEL must be the SAME value used during ingest.py
# and at query time. Changing it after ingestion requires re-running ingest.py.
#
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_EMBED_MODEL=nomic-embed-text


# ── ChromaDB (optional override) ─────────────────────────────────────────────
# Default persist directory is ./chroma_db (relative to project root).
# Override to use an absolute path or a shared volume in Docker.
# CHROMA_PERSIST_DIR=./chroma_db


# ── RAG chunking (optional overrides) ────────────────────────────────────────
# Defaults are set in shared/config.py. Uncomment to tune for your corpus.
# Larger CHUNK_SIZE preserves more context but may exceed the LLM context window.
# Larger CHUNK_OVERLAP reduces information loss at chunk boundaries.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K_RETRIEVAL=5


# ── LangSmith — observability (optional) ─────────────────────────────────────
# When LANGSMITH_API_KEY is set, tracing activates automatically via
# @traceable in rag_pipeline.py and trace_llm_call() in langsmith_tracer.py.
# When unset, all tracing is a no-op — zero performance impact.
#
# Free account:  https://smith.langchain.com
# API key:       https://smith.langchain.com/settings
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=llm-eval-suite
LANGSMITH_TRACING_V2=true